        <mxCell id="JIO5P801PtyTreeA2CTt-302" edge="1" parent="1" source="JIO5P801PtyTreeA2CTt-285" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#E7157B;strokeWidth=1.1;dashed=1;fontSize=8;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=none;" target="JIO5P801PtyTreeA2CTt-267" value="invoca Lambdas">
