        <mxCell id="JIO5P801PtyTreeA2CTt-303" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0BEC5;fontColor=#455A64;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=6;fontStyle=1" value="LEYENDA&lt;br&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;4&quot;&gt;━━ &lt;/span&gt;&lt;strong&gt;RDS Single-AZ:&lt;/strong&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;21&quot;&gt; al ser parte del &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;55&quot;&gt;flujo de administración —de bajo &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;88&quot;&gt;volumen de &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;99&quot;&gt;peticiones y fuera del camino crítico— &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;138&quot;&gt;no se justifica en dos zonas.&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;2&quot;&gt;━━ &lt;/span&gt;&lt;strong&gt;RDS = punto único de fallo aceptado:&lt;/strong&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;43&quot;&gt; si cae la zona de la RDS (1a), los &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;81&quot;&gt;módulos que dependen de ella &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;110&quot;&gt;(financiero y administración) quedan &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;147&quot;&gt;sin &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;151&quot;&gt;servicio, aunque sus Lambdas estén en &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;189&quot;&gt;dos zonas. El resto de flujos &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;219&quot;&gt;(emergencias, alertas, telemetría y &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;255&quot;&gt;estadísticas) sigue &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;275&quot;&gt;operando, ya que usan servicios &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;307&quot;&gt;regionales (DynamoDB, DAX) &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;346&quot;&gt;y no Postgres. Se acepta &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;371&quot;&gt;esta menor disponibilidad del flujo &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;407&quot;&gt;financiero por no ser crítico; si el &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;444&quot;&gt;negocio no lo tolera, se subiría la RDS &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;484&quot;&gt;a Multi-AZ.&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;138&quot;&gt;━━ &lt;/span&gt;&lt;strong&gt;Zona 2 (us-east-1b):&lt;/strong&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;175&quot;&gt; solo contiene &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;212&quot;&gt;Lambdas, que &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;225&quot;&gt;cobran por uso y no impactan costos al &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;264&quot;&gt;duplicarse. El NAT Gateway sí genera &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;301&quot;&gt;costo fijo (por hora) + &lt;/span&gt;&lt;span class=&quot;_animating_yu34g_10&quot; data-newtext-seq=&quot;325&quot;&gt;tráfico,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(69, 90, 100), rgb(148, 166, 175));&quot;&gt;Por eso su duplicación sí impacta y puede evaluarse, considerando que atiende un volumen bajo de peticiones.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="123" width="763" x="212" y="787" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-304" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#4527A0;fontStyle=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4;" value="TABLAS DE ENRUTAMIENTO (Route Tables)" vertex="1">
          <mxGeometry height="300" width="440" x="1340" y="180" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-305" parent="JIO5P801PtyTreeA2CTt-304" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#311B92;fillColor=#F3E5F5;strokeColor=#B39DDB;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;RT · Subredes PÚBLICAS&lt;/b&gt;&amp;nbsp; (10.0.1.0/24 · 10.0.3.0/24)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;10.0.0.0/16&amp;nbsp;&amp;nbsp;→ local&lt;br&gt;0.0.0.0/0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Internet Gateway&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="410" x="14" y="36" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-306" parent="JIO5P801PtyTreeA2CTt-304" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;RT · Subred PRIVADA 1a&lt;/b&gt;&amp;nbsp; (10.0.2.0/24)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;10.0.0.0/16&amp;nbsp;&amp;nbsp;→ local&lt;br&gt;0.0.0.0/0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ NAT Gateway 1a&lt;br&gt;pl-s3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ VPC Endpoint S3 (gratis)&lt;br&gt;pl-dynamodb&amp;nbsp;→ VPC Endpoint DynamoDB (gratis)&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="410" x="14" y="104" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-307" parent="JIO5P801PtyTreeA2CTt-304" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;RT · Subred PRIVADA 1b&lt;/b&gt;&amp;nbsp; (10.0.4.0/24)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;10.0.0.0/16&amp;nbsp;&amp;nbsp;→ local&lt;br&gt;0.0.0.0/0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ NAT Gateway 1b&lt;br&gt;pl-s3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ VPC Endpoint S3 (gratis)&lt;br&gt;pl-dynamodb&amp;nbsp;→ VPC Endpoint DynamoDB (gratis)&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="410" x="14" y="194" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-308" parent="JIO5P801PtyTreeA2CTt-304" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#6A1B9A;fontStyle=2;spacingLeft=8;" value="La línea 0.0.0.0/0 es lo que hace pública o privada a una subred. Cada zona usa su propio NAT." vertex="1">
          <mxGeometry height="30" width="410" x="14" y="282" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-309" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;fontStyle=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4;" value="SECURITY GROUPS  (patrón de cadena · menor privilegio)" vertex="1">
          <mxGeometry height="300" width="440" x="1340" y="500" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-310" parent="JIO5P801PtyTreeA2CTt-309" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#7d4000;fillColor=#FFF3E0;strokeColor=#FFB74D;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-lambdas&lt;/b&gt;&amp;nbsp; (Lambdas en VPC)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;Entrada: — (nadie inicia hacia una Lambda)&lt;br&gt;Salida:&amp;nbsp;&amp;nbsp;TCP 5432 → SG-rds&lt;br&gt;Salida:&amp;nbsp;&amp;nbsp;TCP 8111 → SG-dax&lt;br&gt;Salida:&amp;nbsp;&amp;nbsp;TCP 443&amp;nbsp; → SG-endpoints / 0.0.0.0/0 (NAT)&lt;/span&gt;" vertex="1">
          <mxGeometry height="76" width="410" x="14" y="36" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-311" parent="JIO5P801PtyTreeA2CTt-309" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#7B1FA2;fillColor=#F3E5F5;strokeColor=#CE93D8;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-rds&lt;/b&gt; (PostgreSQL)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;SG-dax&lt;/b&gt; (DAX)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;SG-rds Entrada: TCP 5432 ← SG-lambdas&lt;br&gt;SG-dax Entrada: TCP 8111 ← SG-lambdas&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="410" x="14" y="120" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-312" parent="JIO5P801PtyTreeA2CTt-309" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#4527A0;fillColor=#EDE7F6;strokeColor=#B39DDB;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-endpoints&lt;/b&gt; (Interface Endpoints: Kinesis, CloudWatch)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;Entrada: TCP 443 ← SG-lambdas&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="410" x="14" y="182" as="geometry" />
        </mxCell>
        <mxCell id="JIO5P801PtyTreeA2CTt-313" parent="JIO5P801PtyTreeA2CTt-309" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#1B5E20;fontStyle=2;spacingLeft=8;" value="RDS/DAX/endpoints referencian el SG-lambdas como origen (no IPs). El NAT NO usa SG. S3 y DynamoDB (Gateway Endpoints) tampoco: se controlan por route table." vertex="1">
