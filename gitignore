# ---- Terraform ----
# Directorio de trabajo y plugins descargados (incluye el .exe del provider, +100MB)
**/.terraform/*
.terraform/

# Estado de Terraform (puede contener datos sensibles: contraseñas, endpoints)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Archivos de crash y planes guardados
crash.log
crash.*.log
*.tfplan

# Variables con datos reales (correo, etc.) — NUNCA subir
terraform.tfvars
*.auto.tfvars

# Lock file (opcional: descomenta si NO quieres versionarlo)
